  <inceptionYear>2018</inceptionYear>
  <developers>
    <developer>
      <id>3llomi</id>
      <name>AbdulAlim Rajjoub</name>
      <email>contact@devlomi.com</email>
    </developer>
  </developers>
  <scm>
    <connection>scm:git://github.com/3llomi/CircularStatusView.git</connection>
    <developerConnection>scm:git://github.com/3llomi/CircularStatusView.git</developerConnection>
    <url>git://github.com/3llomi/CircularStatusView.git</url>
  </scm>
  <dependencies>

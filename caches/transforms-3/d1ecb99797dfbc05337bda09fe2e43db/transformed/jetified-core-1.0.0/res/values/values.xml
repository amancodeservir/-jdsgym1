<?xml version="1.0" encoding="utf-8"?>
<resources>
    <dimen name="sp_4dp">4dp</dimen>
    <declare-styleable name="SlidingPanel">
        <attr format="reference" name="slidingView"/>
        <attr format="reference" name="nonSlidingView"/>
        <attr format="reference" name="dragView"/>

        <attr format="reference" name="fitToScreenView"/>

        <attr format="dimension" name="elevation"/>
        <attr format="enum" name="orientation">
            <enum name="vertical" value="0"/>
            <enum name="horizontal" value="1"/>
        </attr>
    </declare-styleable>
</resources>